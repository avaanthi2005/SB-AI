# Free local chat (no per-message API fees; requires Ollama running on your PC)
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Optional paid cloud alternative: set AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PORT=3001

# Account features: Supabase project URL + public ANON key (not service_role key!)
# Vite reads VITE_ variables in browser. Never put secret keys in VITE_ variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Vercel server-only (never use VITE_ for this key)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
